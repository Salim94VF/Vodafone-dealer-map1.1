      <p style="text-align:center"><button type="button" class="lnk" id="toFp">Forgot password?</button></p></form>
    <form id="a_up" hidden><h2 style="margin:0 0 4px">Create your account</h2>
      <label for="u_name">Full Name *</label><input id="u_name" autocomplete="name" required>
      <label for="u_email">Corporate Email *</label><input id="u_email" type="email" autocomplete="email" required>
      <label for="u_mob">Mobile Number *</label><input id="u_mob" type="tel" placeholder="+968 9123 4567" autocomplete="tel" required>
      <label for="u_pw">Password *</label><input id="u_pw" class="pw" type="password" autocomplete="new-password" required>
      <label for="u_pw2">Confirm Password *</label><input id="u_pw2" class="pw" type="password" autocomplete="new-password" required>
      <div class="hint">At least 8 characters, with letters and numbers.</div>
      <label style="font-weight:400"><input type="checkbox" class="spw"> Show passwords</label>
      <div class="m" id="m_up" role="alert"></div><button class="btn" type="submit">Sign up</button></form>
    <form id="a_fp1" hidden><h2 style="margin:0 0 4px">Reset your password</h2><p class="hint">Enter the mobile number registered on your account.</p>
      <label for="f_mob">Mobile Number</label><input id="f_mob" type="tel" placeholder="+968 9123 4567" required>
      <div class="m" id="m_fp1" role="alert"></div><button class="btn" type="submit">Send code</button>
      <p style="text-align:center"><button type="button" class="lnk toIn">Back to sign in</button></p></form>
    <form id="a_fp2" hidden><h2 style="margin:0 0 4px">Enter the code</h2>
      <div class="demo" id="demo" hidden><b>Demo mode.</b> No SMS service is connected, so the code is shown here instead of being texted: <b id="demoCode"></b></div>
      <label for="f_code">6-digit code</label><input id="f_code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required>
      <label for="f_pw">New password</label><input id="f_pw" class="pw" type="password" autocomplete="new-password" required>
      <label for="f_pw2">Confirm new password</label><input id="f_pw2" class="pw" type="password" autocomplete="new-password" required>
      <label style="font-weight:400"><input type="checkbox" class="spw"> Show passwords</label>
      <div class="m" id="m_fp2" role="alert"></div><button class="btn" type="submit">Reset password</button>
      <p style="text-align:center"><button type="button" class="lnk toIn">Back to sign in</button></p></form>
  </div>
</div>
<header>
  <img class="logo" src="data:image/png;base64," alt="Vodafone">
  <div><h1>Dealer Network Intelligence</h1><p>Vodafone Oman · Nationwide Dealer Location &amp; Distribution</p></div>
  <div class="sp"></div>
  <nav class="tabs"><a href="#map" id="tMap" class="on">Map</a><a href="#import" id="tImp">Import data</a><a href="#access" id="tAcc" hidden>Access list</a></nav>

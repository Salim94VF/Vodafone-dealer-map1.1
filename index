  <div class="live ok" id="live"><span class="dot"></span><span id="liveTxt"></span></div>
<button class="btn ghost" id="appBtn" title="Switch between desktop and mobile app layout">Mobile view</button><span id="who"></span><button class="btn ghost" id="out">Sign out</button></header>
<div id="banner" role="alert"></div>
<main id="vMap">
  <section class="cards" aria-label="Key figures">

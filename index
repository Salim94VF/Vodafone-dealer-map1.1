  const msg=staged.n+" new, "+staged.u+" updated";
  DEALERS=[...m.values()];SRC="imported file";UPD=new Date().toISOString();saveLocal();
  staged=null;$("prev").hidden=true;$("paste").value="";location.hash="#map";refreshAll();setTimeout(()=>toast("Map updated: "+msg),300);
};
function dl(name,text,type){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click()}
$("dlJson").onclick=()=>dl("dealers.json",JSON.stringify({updated_at:UPD||new Date().toISOString(),dealers:DEALERS}),"application/json");
$("dlCsv").onclick=()=>dl("dealers-export.csv",[COLS.join(","),...DEALERS.map(d=>COLS.map(c=>'"'+String(d[c]??"").replace(/"/g,'""')+'"').join(","))].join("\n"),"text/csv");
$("rst").onclick=()=>{if(!confirm("Remove imported data from this browser and go back to the built-in dealer list?"))return;try{localStorage.removeItem(LS)}catch(e){}DEALERS=BUILT.dealers.slice();SRC="built-in";UPD=BUILT.updated_at;refreshAll()};
function route(){let h=location.hash.slice(1);if(!["map","import","access"].includes(h))h="map";const u=cur();if((h==="access"||h==="import")&&!(u&&isAdmin(u.email)))h="map";
  $("vMap").hidden=h!=="map";$("vImp").hidden=h!=="import";$("vAcc").hidden=h!=="access";
  [["tMap","map"],["tImp","import"],["tAcc","access"]].forEach(([i,n])=>$(i).classList.toggle("on",h===n));
  if(h==="map")setTimeout(()=>map.resize(),50);if(h==="access")accUI();window.scrollTo(0,0)}
window.addEventListener("hashchange",route);route();

// ===== start: newest of built-in / this browser / dealers.json =====
(async()=>{
  let best=BUILT,src="built-in";
  try{const l=JSON.parse(localStorage.getItem(LS));if(l&&l.dealers&&l.dealers.length&&(l.updated_at||"")>best.updated_at){best=l;src="imported file"}}catch(e){}
  try{const r=await fetch("dealers.json",{cache:"no-store"});if(r.ok){const j=await r.json(),o=Array.isArray(j)?{updated_at:"",dealers:j}:j;if(o.dealers&&o.dealers.length&&(o.updated_at||"")>best.updated_at){best=o;src="dealers.json"}}}catch(e){}
  DEALERS=best.dealers.map(d=>({...d,governorate:govName(d.governorate)}));SRC=src;UPD=best.updated_at;refreshAll();
})();
</script>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:image/png;base64,">
<title>Dealer Network Intelligence – Vodafone Oman</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min.css">
<style>
:root{--red:#e60000;--dark:#2b2b2b;--mid:#6b6b6b;--line:#e4e4e4;--soft:#f5f5f5}
*{box-sizing:border-box}
body{margin:0;font:14px/1.45 "Segoe UI",system-ui,-apple-system,Helvetica,Arial,sans-serif;color:var(--dark);background:var(--soft)}
header{background:var(--dark);color:#fff;display:flex;align-items:center;gap:14px;padding:14px 24px;border-bottom:4px solid var(--red);flex-wrap:wrap}
.logo{width:46px;height:46px;flex:none;display:block}
header h1{margin:0;font-size:21px;font-weight:600}header p{margin:0;color:#c9c9c9;font-size:13px}.sp{flex:1}
button,select,input{font:inherit}
.btn{background:var(--red);color:#fff;border:0;border-radius:6px;padding:8px 14px;cursor:pointer;transition:background .15s}
.btn:hover{background:#b80000}
.live{display:flex;align-items:center;gap:8px;font-size:13px;color:#ddd}
.dot{width:10px;height:10px;border-radius:50%;background:#888}
.live.ok .dot{background:#2ecc71;animation:p 2s infinite}.live.err .dot{background:#ff5a5a}
@keyframes p{0%{box-shadow:0 0 0 0 rgba(46,204,113,.7)}100%{box-shadow:0 0 0 10px rgba(46,204,113,0)}}
#banner{display:none;background:#fff3cd;color:#664d03;padding:10px 24px;border-bottom:1px solid #ffe69c}
main{max-width:1500px;margin:0 auto;padding:18px 24px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}
.card{background:#fff;border-radius:8px;padding:14px 18px;border-left:5px solid var(--red);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.card b{display:block;font-size:30px;line-height:1.1}.card span{color:var(--mid)}.card.g{border-left-color:var(--dark)}
.grid{display:grid;grid-template-columns:340px 1fr;gap:16px;height:680px}
.panel{background:#fff;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.08);padding:14px;display:flex;flex-direction:column;min-height:0}
.panel h2{margin:0 0 10px;font-size:15px}
.panel input,.panel select{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:6px;margin-bottom:8px;background:#fff}
.panel input:focus,.panel select:focus,.btn:focus-visible{outline:2px solid var(--red);outline-offset:1px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#list{overflow:auto;flex:1;margin:6px -6px 0;padding:0 6px}
.item{padding:9px 10px;border:1px solid var(--line);border-radius:6px;margin-bottom:6px;cursor:pointer;transition:border-color .15s,background .15s}
.item:hover,.item:focus-visible{border-color:var(--red);background:#fff6f6;outline:0}.item small{color:var(--mid);display:block}
.tag{float:right;font-size:11px;padding:1px 8px;border-radius:10px;background:#e8f5e9;color:#1b6e2e}.tag.off{background:#eee;color:#666}
.mapwrap{position:relative;border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08);background:#1c2a33}
#map{position:absolute;inset:0}
.ctl{position:absolute;top:12px;right:12px;z-index:5;display:flex;flex-direction:column;gap:6px}
.ctl button{width:42px;height:38px;border:0;border-radius:6px;background:#fff;color:var(--dark);cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.4);font-size:13px;font-weight:600;transition:background .15s,color .15s}
.ctl button:hover,.ctl button.on{background:var(--red);color:#fff}
#toast{position:absolute;left:50%;bottom:22px;transform:translateX(-50%) translateY(20px);opacity:0;background:var(--dark);color:#fff;padding:10px 18px;border-radius:24px;border:2px solid var(--red);z-index:6;transition:all .3s;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%)}
.pinw{width:26px;height:31px;cursor:pointer}
.pin{width:26px;height:26px;background:var(--red);border:2px solid #fff;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 3px 6px rgba(0,0,0,.6);transition:transform .15s}
.pin::after{content:"";position:absolute;width:8px;height:8px;border-radius:50%;background:#fff;top:7px;left:7px}
.pinw:hover .pin{transform:rotate(-45deg) scale(1.2)}
.pinw.new .pin{animation:drop .9s}
@keyframes drop{0%{transform:rotate(-45deg) translate(40px,-40px) scale(1.8);opacity:0}100%{transform:rotate(-45deg)}}
.maplibregl-popup-content{border-radius:8px;border-top:4px solid var(--red);padding:12px 14px}
.pop h3{margin:0 0 6px;font-size:15px}.pop td{padding:2px 10px 2px 0;vertical-align:top}.pop td:first-child{color:var(--mid)}
.bottom{display:grid;grid-template-columns:380px 1fr;gap:16px;margin-top:16px}
.bar{display:grid;grid-template-columns:110px 1fr 28px;gap:8px;align-items:center;margin:7px 0}
.bar i{display:block;height:14px;background:var(--red);border-radius:3px;transition:width .4s}.bar div{background:var(--soft);border-radius:3px}
.tbl{overflow:auto;max-height:340px}table.t{width:100%;border-collapse:collapse}
.t th{position:sticky;top:0;background:var(--dark);color:#fff;text-align:left;padding:8px}.t td{padding:8px;border-bottom:1px solid var(--line)}.t tr:hover td{background:#fff6f6}
.empty{color:var(--mid);padding:14px;text-align:center}.note{font-size:12px;color:var(--mid);margin-top:10px}
@media(max-width:980px){.cards{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr;height:auto}.mapwrap{height:520px;order:-1}#list{max-height:300px}.bottom{grid-template-columns:1fr}main{padding:12px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
[hidden]{display:none!important}
.tabs{display:flex;gap:4px;margin-left:12px}.tabs a{color:#ddd;text-decoration:none;padding:8px 16px;border-radius:6px;font-weight:600}
.tabs a:hover{background:#444}.tabs a.on{background:var(--red);color:#fff}
.imp{max-width:960px;margin:0 auto;display:grid;gap:16px}
.drop{display:block;border:2px dashed #bbb;border-radius:10px;padding:34px 16px;text-align:center;cursor:pointer;transition:all .15s}
.drop:hover,.drop.on{border-color:var(--red);background:#fff6f6}.drop b{display:block;font-size:16px}.drop span{color:var(--mid)}
textarea{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font:12px monospace;margin:6px 0 8px}
.row{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.btn.dk{background:var(--dark)}.btn.dk:hover{background:#000}
.opt{display:block;margin:6px 0}.panel .opt input{width:auto;margin:0 8px 0 0}.sum li{margin:2px 0}
body.locked{overflow:hidden;height:100vh}
body.locked>*:not(#auth){position:absolute;left:0;top:0;width:100%;visibility:hidden;pointer-events:none}
#auth{display:none}
body.locked #auth{display:grid;position:fixed;inset:0;z-index:99999;grid-template-columns:1.15fr .85fr;align-items:center;overflow:auto;color:#fff;background:radial-gradient(900px 600px at 15% 20%,rgba(230,0,0,.35),transparent 60%),radial-gradient(800px 700px at 90% 90%,rgba(120,0,40,.5),transparent 60%),#07070a}
#auth::before{content:"";position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse at center,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse at center,#000 30%,transparent 80%);animation:gridmove 14s linear infinite;pointer-events:none}
@keyframes gridmove{to{background-position:0 56px,56px 0}}
#fx{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}
.ab{position:relative;padding:6vw;display:flex;flex-direction:column;gap:14px}
.lg{position:relative;width:96px;height:96px;margin-bottom:10px}
.lg img{width:96px;height:96px;position:relative;z-index:1;filter:drop-shadow(0 0 22px rgba(230,0,0,.8))}
.lg::before,.lg::after{content:"";position:absolute;inset:-14px;border-radius:50%;border:1px solid rgba(230,0,0,.6);animation:ring 3.2s ease-out infinite}
.lg::after{animation-delay:1.6s}
@keyframes ring{0%{transform:scale(.8);opacity:.9}100%{transform:scale(1.6);opacity:0}}
.ab h1{margin:0;font-size:clamp(30px,4.4vw,58px);line-height:1.05;font-weight:700;letter-spacing:-.02em;background:linear-gradient(90deg,#fff,#ff8a8a 55%,#e60000);-webkit-background-clip:text;background-clip:text;color:transparent}
.ab p{margin:0;color:#b9b9c4;font-size:clamp(14px,1.4vw,18px);max-width:480px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.chips span{border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.05);padding:6px 12px;border-radius:20px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#ddd}
.ab small{color:#8d8d99;margin-top:18px;max-width:420px}
.ac{position:relative;margin:24px auto;padding:30px;width:min(440px,calc(100% - 32px));border-radius:20px;background:rgba(18,18,24,.62);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border:1px solid rgba(255,255,255,.14);box-shadow:0 0 0 1px rgba(230,0,0,.25),0 30px 80px rgba(0,0,0,.6),0 0 60px rgba(230,0,0,.18)}
.ac::before{content:"";position:absolute;left:30px;right:30px;top:-1px;height:2px;background:linear-gradient(90deg,transparent,#e60000,transparent)}
.at{display:flex;background:rgba(255,255,255,.06);border-radius:12px;padding:4px;margin-bottom:18px}
.at button{flex:1;background:none;border:0;padding:10px;font-weight:600;color:#aaa;cursor:pointer;border-radius:9px;transition:all .2s}
.at button.on{background:linear-gradient(135deg,#e60000,#a30000);color:#fff;box-shadow:0 0 18px rgba(230,0,0,.5)}
#auth h2{color:#fff}
#auth label{display:block;font-weight:600;margin:12px 0 5px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#b9b9c4}
#auth input:not([type=checkbox]){width:100%;padding:12px 14px;color:#fff;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:10px;transition:border-color .2s,box-shadow .2s}
#auth input:focus{outline:0;border-color:#e60000;box-shadow:0 0 0 3px rgba(230,0,0,.3),0 0 18px rgba(230,0,0,.35)}
#auth input::placeholder{color:#777}
#auth .btn{width:100%;margin-top:16px;padding:13px;border-radius:10px;font-weight:700;letter-spacing:.04em;background:linear-gradient(135deg,#ff2b2b,#c00000);box-shadow:0 0 24px rgba(230,0,0,.45);transition:transform .15s,box-shadow .15s}
#auth .btn:hover{transform:translateY(-1px);box-shadow:0 0 34px rgba(230,0,0,.7)}
#auth button:focus-visible{outline:2px solid #fff;outline-offset:2px}
.lnk{color:#ff7b7b;cursor:pointer;background:none;border:0;padding:0;text-decoration:underline}
.m{min-height:20px;margin-top:10px;font-size:13px}.m.err{color:#ff8a8a}.m.ok{color:#6ee7a0}.hint{font-size:12px;color:#8d8d99;margin-top:4px}
.demo{background:rgba(255,193,7,.1);border:1px solid rgba(255,193,7,.4);color:#ffd866;padding:10px;border-radius:10px;font-size:13px;margin-top:12px}.demo b:last-child{font-size:20px;letter-spacing:3px}
.corner{position:fixed;top:14px;right:16px;z-index:3;background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:6px 14px;cursor:pointer;font-size:12px}
@media(max-width:860px){body.locked #auth{grid-template-columns:1fr;align-items:start}.ab{padding:70px 24px 0}.chips,.ab small{display:none}.ab h1{font-size:30px}.lg,.lg img{width:64px;height:64px}}
@media(prefers-reduced-motion:reduce){#auth::before,.lg::before,.lg::after{animation:none}}
.btn.ghost{background:transparent;border:1px solid #777}.btn.ghost:hover{background:#444}#who{color:#ddd;font-size:13px}
.svl{margin:8px 0 0;font-size:13px}.svl a{color:var(--red);font-weight:600}
html:has(body.app){background:#161616}
body.app{max-width:430px;margin:0 auto;box-shadow:0 0 50px rgba(0,0,0,.6);min-height:100vh;padding-bottom:64px}
body.app header{padding:10px 14px;gap:10px}body.app header h1{font-size:15px}body.app header p,body.app #live,body.app .sp,body.app #who{display:none}
body.app .logo{width:34px;height:34px}body.app #out,body.app #appBtn{padding:6px 10px;font-size:12px}
body.app .tabs{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(430px,100%);margin:0;background:var(--dark);border-top:3px solid var(--red);z-index:1000;justify-content:space-around;padding:6px 4px;gap:0}
body.app .tabs a{flex:1;text-align:center;font-size:12px;padding:10px 4px}
body.app main{padding:10px}body.app .cards{grid-template-columns:repeat(3,1fr);gap:8px}body.app .card{padding:8px 10px}body.app .card b{font-size:22px}body.app .card span{font-size:11px}
body.app .grid{grid-template-columns:1fr;height:auto}body.app .mapwrap{height:62vh;order:-1}body.app #list{max-height:260px}body.app .bottom{grid-template-columns:1fr}
body.app .ctl button{width:44px;height:44px}
</style>
</head>
<body class="locked">
<div id="auth">
  <canvas id="fx" aria-hidden="true"></canvas><button type="button" id="appBtn2" class="corner">Mobile view</button>
  <div class="ab"><div class="lg"><img id="authLogo" alt="Vodafone" width="96" height="96"></div><h1>Dealer Network Intelligence</h1><p>Vodafone Oman · every dealer, every governorate, one live 3D map.</p><div class="chips"><span>3D terrain</span><span>Live filters</span><span>Street view</span></div><small>Authorised users only. Your email must be approved by the portal administrator before you can sign up.</small></div>
  <div class="ac">
    <div class="at" id="atabs"><button type="button" id="bIn" class="on">Sign in</button><button type="button" id="bUp">Sign up</button></div>
    <form id="a_in"><h2 style="margin:0 0 4px">Welcome back</h2>
      <label for="i_email">Email</label><input id="i_email" type="email" autocomplete="username" required>
      <label for="i_pw">Password</label><input id="i_pw" class="pw" type="password" autocomplete="current-password" required>
      <label style="font-weight:400"><input type="checkbox" class="spw"> Show password</label>
